# Copy to .dbw.env (gitignored) or let scripts/intune-login.sh write it for you.
# Sourced by scripts/lib/graph.sh.

# Use a dedicated Azure CLI profile so the Intune identity never collides with the
# account you normally use with az.
export DBW_AZURE_CONFIG_DIR="$HOME/.azure-intune"

# Refuse to deploy, update or tear down as anyone else.
export DBW_EXPECT_UPN="intune-admin@contoso.com"

# Optional: pin the tenant.
# export DBW_TENANT_ID="contoso.com"

# Optional: app registration instead of a signed-in user (CI). Needs the APPLICATION
# permission DeviceManagementScripts.ReadWrite.All with admin consent. When these are
# set the Azure CLI is not used at all, and DBW_EXPECT_UPN must be unset.
# export DBW_CLIENT_ID="..."
# export DBW_CLIENT_SECRET="..."
